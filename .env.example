# Firebase Web App client configuration. These values identify the app; they are not admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth client with application type "Desktop app".
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Google Desktop OAuth client secret. Google treats Desktop clients as public;
# this value will be embedded in a release binary and must not be treated as confidential.
THEHUB_GOOGLE_OAUTH_CLIENT_SECRET=
