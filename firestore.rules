rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The Firebase Web API key and the Desktop OAuth client are public by design,
    // so any Google account can create a Firebase Auth user in this project.
    // Only accounts listed in /allowedUsers/{uid} may use the database. Add those
    // documents from the Firebase console; clients can never read or write them.
    function isAllowedUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    match /users/{userId}/quickNotes/{noteId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && noteId == 'sharedV'
          && isAllowedUser();
      }

      function hasValidPayload() {
        return request.resource.data.keys().hasOnly(['content', 'revision', 'updatedAt', 'ownerUid'])
          && request.resource.data.keys().hasAll(['content', 'revision', 'updatedAt', 'ownerUid'])
          && request.resource.data.content is string
          // Matches the client limit in src/services/firebaseSharedNotes.ts.
          && request.resource.data.content.size() <= 230000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time
          && request.resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && hasValidPayload()
        && request.resource.data.revision == 1;
      allow update: if isOwner()
        && hasValidPayload()
        && resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;

      allow delete: if false;
    }

    // Everything else, including /allowedUsers, is closed to clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
