rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/quickNotes/{noteId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && noteId == 'sharedV';
      }

      function hasValidPayload() {
        return request.auth != null
          && request.resource.data.keys().hasOnly(['content', 'revision', 'updatedAt', 'ownerUid'])
          && request.resource.data.keys().hasAll(['content', 'revision', 'updatedAt', 'ownerUid'])
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 700000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && hasValidPayload()
        && request.resource.data.revision == 1;
      allow update: if isOwner()
        && hasValidPayload()
        && resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;

      allow delete: if false;
    }
  }
}
